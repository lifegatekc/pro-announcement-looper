{
  "version": "0.2.0",
  "configurations": [{
    "name": "Announcement Loop: player",
    "type": "brightscript", "request": "launch",
    "host": "${prompt:rokuHost}", "password": "${prompt:rokuPassword}",
    "rootDir": "${workspaceFolder}/out/player", "stopOnEntry": false
